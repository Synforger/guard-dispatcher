#!/usr/bin/env bash
# =============================================================================
# Global pre-push dispatcher
# =============================================================================
# Behaviour:
#   1. If the repo ships `.githooks/pre-push`, run it first (AND — a pass
#      does not skip the baseline below). stdin ref lines are captured
#      once and re-fed to both consumers.
#   2. On every repo except an explicit `exempt`, parse the captured ref
#      ranges and run `.tooling/local-ci/anon-audit-deep.sh --range` on each
#      outgoing commit range + scan the ref name. Default-on. Missing
#      scanner = hard fail.
#   3. Protected-branch and author-identity enforcement stay scoped to
#      synforger / enforced / no-remote — `other` repos are scanned but keep
#      their own push flow and committer identities.
#
# stdin format (per git hooks docs):
#   <local-ref> SP <local-sha> SP <remote-ref> SP <remote-sha> LF
# A remote-sha of all zeros = new branch on the remote.
# A local-sha  of all zeros = branch delete (skipped, no diff to scan).
#
# Range calculation: scanners/dest-known.py (`range`) alone decides which
# commits each ref sends and whether the push rewrites history; see its
# docstring.
# =============================================================================
set -eu

# shellcheck source=lib/dispatcher-common.sh
. "$(dirname "$0")/lib/dispatcher-common.sh"

# Capture the ref lines before anything else consumes stdin — both the
# repo-local hook and the baseline loop below need them.
ref_lines="$(cat)"

local_status=0
if [ -n "${ref_lines}" ]; then
    printf '%s\n' "${ref_lines}" | dispatcher::run_local_hook "pre-push" "$@" || local_status=$?
else
    dispatcher::run_local_hook "pre-push" "$@" </dev/null || local_status=$?
fi

kind="$(dispatcher::detect_repo_kind)"
if [ "${kind}" = "exempt" ]; then
    exit "${local_status}"
fi

# Content + ref-name scans run for every non-exempt repo (default-on). The
# protected-branch guard and author-identity enforcement are push-flow rules
# that only make sense where a specific identity is required — `other` repos
# (arbitrary remotes) are still scanned but keep their own flow and authors.
enforce_identity=0
case "${kind}" in
    synforger|no-remote|enforced) enforce_identity=1 ;;
esac
# `corpus`: only the private-document scan runs (see dispatcher-common.sh).
corpus_only=0
[ "${kind}" = "corpus" ] && corpus_only=1

scanner="$(dispatcher::locate_deep_scanner || true)"
if [ -z "${scanner}" ]; then
    cat >&2 <<'MSG'
[pre-push] anon-audit-deep.sh could not be resolved (repo-local or guard
           bundled). The guard checkout is likely missing or moved —
           re-run its install.sh from a healthy checkout.
MSG
    exit 1
fi

# What a push sends is decided in scanners/dest-known.py alone: which commits go out, whether the
# push rewrites history, and what of it the destination already holds. No check below reads the
# history on its own; each is handed the same range and the same folder.
dest_tool="$(dispatcher::locate_scanner "dest-known.py" || true)"
if [ -z "${dest_tool}" ]; then
    printf '[pre-push] dest-known.py could not be resolved — re-run install.sh from a healthy checkout\n' >&2
    exit 1
fi

zero='0000000000000000000000000000000000000000'
remote_name="${1:-origin}"
push_url="${2:-}"
# The push-flow rules follow where the push goes too, not only where origin points: a clone made
# from a bundle or a local path has an origin that names no host, and its push still lands in the
# org's repository.
if [ "${enforce_identity}" = "0" ] && dispatcher::is_synforger_url "${push_url}"; then
    enforce_identity=1
fi
allowed_emails="$(dispatcher::allowed_emails)"
any_leak=0

# What the destination's history already holds, fetched once and only when a check needs it.
# A history rewritten to take a word out gives every commit a new hash, colleagues' too: they are
# no longer on any remote, so the identity check takes them for commits made here, and the whole
# history is scanned as if all of it were leaving. scanners/dest-known.py writes what the
# destination holds into one folder, and every check of a rewritten push leaves out the same
# things: authors and committers it already carries, files whose blob it already holds, commit
# texts it already has. What the rewrite made new is checked as before.
dest_known=""
dest_loaded=0
trap '[ -z "${dest_known}" ] || rm -rf "${dest_known}"' EXIT
load_dest() {
    [ "${dest_loaded}" = 1 ] && return 0
    dest_loaded=1
    local ns="refs/guard-dest/$$" refs
    if git fetch -q --no-tags "${push_url:-${remote_name}}" \
            "+refs/heads/*:${ns}/heads/*" "+refs/tags/*:${ns}/tags/*" 2>/dev/null; then
        refs="$(git for-each-ref --format='%(refname)' "${ns}")"
        if [ -n "${refs}" ]; then
            dest_known="$(mktemp -d)"
            # shellcheck disable=SC2086 — one ref per word
            if ! python3 "${dest_tool}" build "${dest_known}" ${refs}; then
                rm -rf "${dest_known}"
                dest_known=""
            fi
        fi
    fi
    git for-each-ref --format='%(refname)' "${ns}" | while read -r ref; do git update-ref -d "${ref}"; done
}
# Tips of the refs this push has already scanned clean, as ^<sha>. A new ref
# counts them as published: every tag of a history pushed to an empty remote
# would otherwise re-scan that whole history once per tag.
scanned=()

# Iterate the captured ref lines. An empty push (no matching refspec)
# just falls through.
while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "${local_ref}" ] && continue

    # delete push — nothing outgoing to scan
    if [ "${local_sha}" = "${zero}" ]; then
        continue
    fi

    # Protected-branch guard: PR merges happen server-side, so a direct
    # local push to main/develop is a process violation. The initial push
    # that creates the branch on the remote is the one legitimate case, and a
    # remote with no pull requests at all has no such flow to bypass.
    # GUARD_ALLOW_PROTECTED_PUSH=1 is the audited escape hatch.
    if [ "${enforce_identity}" = "1" ] \
        && dispatcher::merges_through_prs "${push_url}" \
        && dispatcher::protected_branch "${remote_ref}" \
        && [ "${remote_sha}" != "${zero}" ] \
        && [ "${GUARD_ALLOW_PROTECTED_PUSH:-0}" != "1" ]; then
        printf '[pre-push] direct push to %s refused (use a PR; set GUARD_ALLOW_PROTECTED_PUSH=1 to override once)\n' "${remote_ref}" >&2
        any_leak=1
        continue
    fi

    # Ref-name scan: a branch or tag name is published as-is on the remote,
    # so it crosses the same boundary as file content.
    if [ "${corpus_only}" = "0" ]; then
        ref_scanner="$(dispatcher::locate_anon_scanner || true)"
        if [ -z "${ref_scanner}" ]; then
            printf '[pre-push] anon-scan.sh could not be resolved (repo-local or guard bundled) — re-run install.sh from a healthy checkout\n' >&2
            exit 1
        fi
        ref_tmp="$(mktemp)"
        printf '%s\n' "${local_ref}" > "${ref_tmp}"
        if ! ANON_SCAN_PATHS="${ref_tmp}" bash "${ref_scanner}" >/dev/null 2>&1; then
            printf '[pre-push] ref name %s matches the word list — rename the branch/tag before pushing\n' "${local_ref}" >&2
            rm -f "${ref_tmp}"
            any_leak=1
            continue
        fi
        rm -f "${ref_tmp}"
    fi

    # Which commits go out, and whether the push rewrites history (= a whole history, or over a tip
    # it does not descend from): what the destination already holds is then left out of every
    # check (= GUARD_DEST_KNOWN). Commits an earlier ref of this push already scanned count as
    # published.
    if ! plan="$(python3 "${dest_tool}" range "${remote_name}" "${local_sha}" "${remote_sha}" ${scanned[@]+"${scanned[@]}"})"; then
        printf '[pre-push] dest-known.py could not decide what %s sends — refusing the push\n' "${local_ref}" >&2
        exit 1
    fi
    [ -z "${plan}" ] && continue
    { read -r change; read -r revspec; } <<< "${plan}"
    dest_env=""
    if [ "${change}" = rewritten ]; then
        load_dest
        dest_env="${dest_known}"
    fi

    # Identity check over the outgoing commits: every author and committer
    # must be the expected public identity for this machine's enforced org.
    # Only enforced-identity scopes — `other` repos keep their own authors.
    #
    # GitHub-hosted bot accounts are exempt by shape (= a merged dependabot PR
    # puts one into the history, and promoting that history would otherwise
    # fail a check with nothing left to protect). See
    # dispatcher::history_identity_exempt_re for why it is matched, not listed.
    #
    # Only commits no remote holds yet were made here: a colleague's commit or a workflow's, fetched
    # from the org and now pushed on to another remote (a machine over ssh), has its own right author.
    if [ "${enforce_identity}" = "1" ]; then
        read -ra revs <<< "${revspec}"
        # outgoing_ids — the addresses of the outgoing commits no remote holds, less the
        # destination's, the allowed identities and GitHub's bot accounts
        outgoing_ids() {
            local ids
            ids="$(python3 "${dest_tool}" addresses "${dest_known}" "${revs[@]}")" || return 1
            printf '%s\n' "${ids}" | grep -v '^$' \
                | grep -Fxvf <(printf '%s\n' "${allowed_emails}") \
                | grep -Ev "$(dispatcher::history_identity_exempt_re)" || true
        }
        if ! bad_ids="$(outgoing_ids)"; then
            printf '[pre-push] dest-known.py could not read the authors of %s — refusing the push\n' "${revspec}" >&2
            exit 1
        fi
        if [ -n "${bad_ids}" ] && [ "${dest_loaded}" = 0 ]; then
            # someone unknown here: the destination may have carried them all along
            load_dest
            if [ -n "${dest_known}" ] && ! bad_ids="$(outgoing_ids)"; then
                printf '[pre-push] dest-known.py could not read the authors of %s — refusing the push\n' "${revspec}" >&2
                exit 1
            fi
        fi
        if [ -n "${bad_ids}" ]; then
            printf '[pre-push] unexpected author/committer in outgoing range %s:\n' "${revspec}" >&2
            printf '%s\n' "${bad_ids}" | sed 's/^/    /' >&2
            printf '           allowed identities:\n' >&2
            printf '%s\n' "${allowed_emails}" | sed 's/^/    /' >&2
            printf '           plus GitHub bot accounts (= <id>+<name>[bot]@users.noreply.github.com)\n' >&2
            any_leak=1
            continue
        fi
    fi

    # Text copied out of a private document is on no word list; compare the
    # outgoing lines with the documents of every area the destination is
    # outside of (= a public GitHub repo is outside all of them, wherever its
    # clone lives).
    # GUARD_CORPUS_SKIP=1 is the audited escape hatch for a single push.
    if [ "${GUARD_CORPUS_SKIP:-0}" != "1" ]; then
        corpus="$(dispatcher::locate_scanner "corpus-scan.py" || true)"
        if [ -z "${corpus}" ]; then
            printf '[pre-push] corpus-scan.py could not be resolved — re-run install.sh from a healthy checkout\n' >&2
            exit 1
        fi
        if ! GUARD_DEST_KNOWN="${dest_env}" python3 "${corpus}" --range "${revspec}" --dest "${push_url}"; then
            any_leak=1
            continue
        fi
    fi

    if [ "${corpus_only}" = "1" ]; then
        [ "${any_leak}" -eq 0 ] && scanned+=("^${local_sha}")
        continue
    fi

    printf '[pre-push] anon-audit-deep --range %s (ref %s)\n' "${revspec}" "${local_ref}" >&2
    if ! GUARD_DEST_KNOWN="${dest_env}" bash "${scanner}" --range "${revspec}"; then
        # Try to self-heal only when the operator opted in — a silent
        # filter-repo pass on every push would be too surprising, and it
        # can't undo a mis-scoped rewrite.
        fixer="$(dispatcher::locate_scanner "anon-fix.sh" || true)"
        if [ "${ANON_FIX_AUTO:-0}" = "1" ] && [ -n "${fixer}" ]; then
            echo "[pre-push] ANON_FIX_AUTO=1 — running anon-fix.sh --auto..." >&2
            if bash "${fixer}" --range "${revspec}" --auto; then
                echo "[pre-push] anon-fix succeeded; push proceeds." >&2
                continue
            fi
            echo "[pre-push] anon-fix failed — refusing push." >&2
            any_leak=1
        else
            cat >&2 <<HINT

To scrub the leak in place before push (rewrites the outgoing range
so the public record shows neither the leak nor a repair scar):

    bash ${fixer:-<guard>/scanners/anon-fix.sh} --range ${revspec}

Or export ANON_FIX_AUTO=1 to have this hook do it for you automatically.
HINT
            any_leak=1
        fi
    fi

    # Remember the tip only while everything so far is clean: a refused push
    # has nothing left to save time on.
    [ "${any_leak}" -eq 0 ] && scanned+=("^${local_sha}")
done <<EOF_REFS
${ref_lines}
EOF_REFS

if [ "${any_leak}" -ne 0 ]; then
    exit 1
fi
exit "${local_status}"
